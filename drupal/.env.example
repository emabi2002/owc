DRUPAL_HTTP_PORT=8088
DRUPAL_DB_NAME=owc_drupal
DRUPAL_DB_USER=owc_drupal
DRUPAL_DB_PASSWORD=replace-with-strong-secret
DRUPAL_SITE_NAME=OWC Enterprise CMS
DRUPAL_ADMIN_USER=owcadmin
DRUPAL_ADMIN_PASSWORD=replace-with-strong-admin-secret
DRUPAL_ADMIN_EMAIL=admin@owc.gov.pg
DRUPAL_TRUSTED_HOST_PATTERN=^cms\\.owc\\.gov\\.pg$

# Drupal editor OIDC / SSO. Store real values in the approved secret store.
OWC_OIDC_CLIENT_ID=
OWC_OIDC_CLIENT_SECRET=
OWC_OIDC_AUTHORIZATION_ENDPOINT=
OWC_OIDC_TOKEN_ENDPOINT=
OWC_OIDC_USERINFO_ENDPOINT=
OWC_OIDC_END_SESSION_ENDPOINT=
OWC_IDENTITY_ENFORCE_SSO=0
OWC_BREAK_GLASS_LOCAL_LOGIN=0
