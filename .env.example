# ============================================================================
# OWC PNG — Environment configuration (EXAMPLE)
# Copy to `.env.local` for local development or set these in your host / CI.
# NEVER commit real secrets. `.env*` is git-ignored.
# ============================================================================

# ----------------------------------------------------------------------------
# Site
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://owc.gov.pg"

# ----------------------------------------------------------------------------
# Supabase (Auth + PostgreSQL)
# Project Settings → API. Leave blank to run against local seed content.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
OWC_BOOTSTRAP_ADMIN_EMAILS="admin@owc.gov.pg"

# ----------------------------------------------------------------------------
# Drupal Enterprise CMS
# Drupal owns editorial/public content. `auto` prefers Drupal when configured,
# then falls back to Supabase and finally the existing seed dataset.
# ----------------------------------------------------------------------------
DRUPAL_BASE_URL=""
DRUPAL_API_TOKEN=""
OWC_CONTENT_SOURCE="auto"

# ----------------------------------------------------------------------------
# CPPS — Compensation Processing & Payment System (claims back-end)
# ----------------------------------------------------------------------------
CPPS_API_BASE_URL=""
CPPS_API_KEY=""
CPPS_GRAPHQL_ENDPOINT=""

# ----------------------------------------------------------------------------
# Controlled external-service integration environment
# Keep FALSE unless the integration service adapters are intentionally enabled.
# ----------------------------------------------------------------------------
OWC_ENABLE_SANDBOX="false"

# ----------------------------------------------------------------------------
# Claim evidence upload + malware scanning
# Claimant/mobile uploads are authorized by a short-lived HMAC token issued only
# after successful claim lodgement. Use a randomly generated secret >=32 chars.
# Scanner endpoint accepts raw file bytes via POST and returns JSON such as
# {"clean":true} or {"clean":false,"threat":"signature"}.
# Set OWC_REQUIRE_MALWARE_SCAN=true in production to fail closed if unavailable.
# ----------------------------------------------------------------------------
OWC_EVIDENCE_UPLOAD_SIGNING_SECRET=""
OWC_MALWARE_SCAN_URL=""
OWC_MALWARE_SCAN_API_KEY=""
OWC_REQUIRE_MALWARE_SCAN="false"

# ----------------------------------------------------------------------------
# Claimant email/SMS notification gateway
# Provider-neutral server endpoint. OWC sends channel, recipient, subject,
# message, claim reference and lifecycle event. Credentials remain server-side.
# ----------------------------------------------------------------------------
OWC_NOTIFICATION_API_URL=""
OWC_NOTIFICATION_API_KEY=""

# ----------------------------------------------------------------------------
# CAPTCHA (public forms)
# provider: fallback | turnstile | recaptcha | hcaptcha
# ----------------------------------------------------------------------------
NEXT_PUBLIC_CAPTCHA_PROVIDER="fallback"
NEXT_PUBLIC_CAPTCHA_SITE_KEY=""
CAPTCHA_SECRET_KEY=""

# ----------------------------------------------------------------------------
# Rate limiting (optional Upstash Redis for distributed limits)
# ----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
