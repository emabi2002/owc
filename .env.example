# ============================================================================
# OWC PNG — Environment configuration (EXAMPLE)
# Copy to `.env.local` for local development or set these in your host / CI.
# NEVER commit real secrets. `.env*` is git-ignored.
# ============================================================================

# ----------------------------------------------------------------------------
# Site
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://owc.gov.pg"

# ----------------------------------------------------------------------------
# Identity
# `live` uses the approved Supabase/IdP path and fails closed if unavailable.
# `demonstration` enables the synthetic OWC presentation identities.
# Use a random OWC_DEMO_SESSION_SECRET of at least 32 characters, replace the
# shared presentation password, and configure a six-digit demonstration MFA code.
# Whole-environment reset is available only when BOTH identity mode is
# demonstration and OWC_ENABLE_DEMO_RESET=true; never enable it in production.
# ----------------------------------------------------------------------------
OWC_IDENTITY_MODE=live
OWC_DEMO_SESSION_SECRET=""
OWC_DEMO_PASSWORD=""
OWC_DEMO_MFA_CODE=""
OWC_ENABLE_DEMO_RESET="false"

# ----------------------------------------------------------------------------
# Supabase (Auth + PostgreSQL)
# Project Settings → API. Leave blank only when live identity/data are not used.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
OWC_BOOTSTRAP_ADMIN_EMAILS="admin@owc.gov.pg"

# ----------------------------------------------------------------------------
# OWC AI gateway
# `disabled` is the safe default. `reference` enables the explicitly synthetic
# bidding/demo provider. `openai_compatible` calls one approved server-side
# chat-completions compatible endpoint. Keys are never exposed to browsers.
# A failed live provider never falls back silently to the reference provider.
# ----------------------------------------------------------------------------
OWC_AI_PROVIDER="disabled"
OWC_AI_API_URL=""
OWC_AI_API_KEY=""
OWC_AI_MODEL=""

# ----------------------------------------------------------------------------
# Drupal Enterprise CMS
# Drupal owns editorial/public content. `auto` prefers Drupal when configured,
# then falls back to Supabase and finally the existing seed dataset.
# ----------------------------------------------------------------------------
DRUPAL_BASE_URL=""
DRUPAL_API_TOKEN=""
OWC_CONTENT_SOURCE="auto"

# ----------------------------------------------------------------------------
# CPPS — Compensation Processing & Payment System (claims back-end)
# Leave OWC_ENABLE_REFERENCE_ECOSYSTEM=false in production. In controlled
# development/UAT/demo environments it may be set to true to use the explicitly
# synthetic reference CPPS when no live CPPS endpoint is configured.
# A configured live CPPS always takes precedence.
# ----------------------------------------------------------------------------
CPPS_API_BASE_URL=""
CPPS_API_KEY=""
CPPS_GRAPHQL_ENDPOINT=""
OWC_ENABLE_REFERENCE_ECOSYSTEM="false"

# ----------------------------------------------------------------------------
# Controlled external-service integration environment
# Keep FALSE unless the integration service adapters are intentionally enabled.
# ----------------------------------------------------------------------------
OWC_ENABLE_SANDBOX="false"

# ----------------------------------------------------------------------------
# Claim evidence upload + malware scanning
# Claimant/mobile uploads are authorized by a short-lived HMAC token issued only
# after successful claim lodgement. Use a randomly generated secret >=32 chars.
# A configured live scanner endpoint is always authoritative. The reference
# scanner is a deterministic synthetic demonstration aid only and does NOT
# provide malware protection. Keep it false outside controlled DEV/UAT/demo use.
# Set OWC_REQUIRE_MALWARE_SCAN=true in production and configure an approved live
# scanner endpoint/provider before production acceptance.
# The reference evidence repository is process-local synthetic demonstration
# storage only. Keep it false outside controlled DEV/UAT/demo use.
# ----------------------------------------------------------------------------
OWC_EVIDENCE_UPLOAD_SIGNING_SECRET=""
OWC_MALWARE_SCAN_URL=""
OWC_MALWARE_SCAN_API_KEY=""
OWC_REQUIRE_MALWARE_SCAN="false"
OWC_ENABLE_REFERENCE_MALWARE_SCANNER="false"
OWC_ENABLE_REFERENCE_EVIDENCE_REPOSITORY="false"

# ----------------------------------------------------------------------------
# Claimant email/SMS notification gateway
# A configured live gateway is always authoritative. The reference notification
# gateway records deterministic process-local synthetic deliveries only; it does
# not send real email or SMS. Keep it false outside controlled DEV/UAT/demo use.
# ----------------------------------------------------------------------------
OWC_NOTIFICATION_API_URL=""
OWC_NOTIFICATION_API_KEY=""
OWC_ENABLE_REFERENCE_NOTIFICATION_GATEWAY="false"

# ----------------------------------------------------------------------------
# CAPTCHA (public forms)
# provider: fallback | turnstile | recaptcha | hcaptcha
# ----------------------------------------------------------------------------
NEXT_PUBLIC_CAPTCHA_PROVIDER="fallback"
NEXT_PUBLIC_CAPTCHA_SITE_KEY=""
CAPTCHA_SECRET_KEY=""

# ----------------------------------------------------------------------------
# Rate limiting (optional Upstash Redis for distributed limits)
# ----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""