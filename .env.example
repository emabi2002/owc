# ============================================================================
# OWC PNG — Environment configuration (EXAMPLE)
# Copy to `.env.local` for local development or set these in your host / CI.
# NEVER commit real secrets. `.env*` is git-ignored.
# ============================================================================

# ----------------------------------------------------------------------------
# Site
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://owc.gov.pg"

# ----------------------------------------------------------------------------
# Supabase (Auth + PostgreSQL)
# Project Settings → API. Leave blank to run in local seed/demo mode.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Bypasses Row Level Security — keep secret, never expose client-side.
SUPABASE_SERVICE_ROLE_KEY=""

# Comma-separated emails auto-promoted to Administrator on first sign-in.
OWC_BOOTSTRAP_ADMIN_EMAILS="admin@owc.gov.pg"

# ----------------------------------------------------------------------------
# CPPS — Compensation Processing & Payment System (claims back-end)
# REST base URL and/or GraphQL endpoint. Leave blank to use mock claim data.
# ----------------------------------------------------------------------------
CPPS_API_BASE_URL=""
CPPS_API_KEY=""
CPPS_GRAPHQL_ENDPOINT=""

# ----------------------------------------------------------------------------
# CAPTCHA (public forms)
# provider: fallback | turnstile | recaptcha | hcaptcha
# `fallback` uses the built-in arithmetic challenge (no keys required).
# ----------------------------------------------------------------------------
NEXT_PUBLIC_CAPTCHA_PROVIDER="fallback"
NEXT_PUBLIC_CAPTCHA_SITE_KEY=""
CAPTCHA_SECRET_KEY=""

# ----------------------------------------------------------------------------
# Rate limiting (optional Upstash Redis for distributed limits)
# Falls back to in-memory limiting when unset.
# ----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
